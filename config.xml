<?xml version='1.0' encoding='utf-8'?>
<widget id="fun.openzoo.psg1" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>OpenZoo</name>
    <description>OpenZoo for Play Solana PSG1 — grokui threads, chat (x402/MWA), and Agent IDE (cloud code-server + Cline via /ide/session). The handheld talks directly to the gateway; no localhost proxy.</description>
    <author href="https://playsolana.com">
        OpenZoo
    </author>

    <!-- Local shell owns MWA; bundled OpenZoo UI loads in an iframe -->
    <content src="index.html" />

    <!-- Bundled app + live x402 gateway (CORS is live; do not bounce :8402) -->
    <access origin="https://x402-tokens.fly.dev" />
    <access origin="https://x402.accrue.fund" />
    <access origin="https://api.mainnet-beta.solana.com" />
    <access origin="https://zoo.openzoo.fun" />
    <access origin="https://*.openzoo.fun" />
    <allow-navigation href="https://x402-tokens.fly.dev/*" />
    <allow-navigation href="https://zoo.openzoo.fun/*" />
    <allow-navigation href="https://*.openzoo.fun/*" />

    <!-- Open wallet / external links in system browser -->
    <allow-intent href="https://*/*" />
    <!-- MWA uses solana-wallet:// scheme to discover & connect native wallet apps -->
    <allow-intent href="solana-wallet://*" />

    <!-- Fullscreen immersive mode — PSG1 is 1240×1080, nearly square -->
    <preference name="Fullscreen" value="true" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#080a08" />
    <preference name="StatusBarStyle" value="lightcontent" />
    <preference name="KeepRunning" value="true" />
    <preference name="Orientation" value="default" />
    <preference name="BackgroundColor" value="0xff0A080D" />
    <preference name="SplashScreenDelay" value="0" />
    <preference name="FadeSplashScreen" value="false" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="DisallowOverscroll" value="true" />

    <!-- Android specific -->
    <platform name="android">
        <preference name="AndroidWindowSplashScreenBackground" value="#0A080D" />
        <preference name="AndroidPersistentFileLocation" value="Compatibility" />
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <preference name="immersiveMode" value="true" />
        <preference name="MediaPlaybackRequiresUserAction" value="false" />
        <preference name="OverrideBackButton" value="true" />
        <!-- singleTask: returning from Jupiter Wallet reuses the existing activity -->
        <preference name="AndroidLaunchMode" value="singleTask" />

        <!-- Icons -->
        <icon density="ldpi" src="res/icon/android/ldpi.png" />
        <icon density="mdpi" src="res/icon/android/mdpi.png" />
        <icon density="hdpi" src="res/icon/android/hdpi.png" />
        <icon density="xhdpi" src="res/icon/android/xhdpi.png" />
        <icon density="xxhdpi" src="res/icon/android/xxhdpi.png" />
        <icon density="xxxhdpi" src="res/icon/android/xxxhdpi.png" />
    </platform>
</widget>

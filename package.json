{
  "name": "fun.openzoo.psg1",
  "displayName": "OpenZoo",
  "version": "1.0.0",
  "description": "OpenZoo for Play Solana PSG1 — grokui threads/chat/wallet via Jupiter Wallet (MWA) and x402. Android + EchOS only.",
  "main": "index.js",
  "scripts": {
    "build": "cordova build android",
    "build:release": "cordova build android --release",
    "run": "cordova run android",
    "clean": "cordova clean android",
    "requirements": "cordova requirements android",
    "icons": "python3 scripts/generate-icons.py",
    "test": "node --test test/*.test.js",
    "verify:gateway": "node scripts/verify-gateway.mjs"
  },
  "keywords": [
    "ecosystem:cordova",
    "openzoo",
    "play-solana",
    "psg1",
    "mobile-wallet-adapter",
    "x402"
  ],
  "license": "MIT",
  "devDependencies": {
    "cordova-android": "^14.0.1",
    "cordova-plugin-mwa": "file:cordova-plugin-mwa"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-mwa": {}
    }
  }
}
